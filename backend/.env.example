# Backend environment variables for ETradie

# PostgreSQL connection string, e.g.
# DATABASE_URL="postgresql://user:password@localhost:5432/etradie?schema=public"
DATABASE_URL=

# Secret used to sign JWTs. Use a long random string in production.
JWT_SECRET=changeme-in-production

# Port for the Express/Socket.IO server to listen on.
PORT=4000

# URL of the React frontend (used by CORS and Socket.IO).
CLIENT_URL=http://localhost:5173

# SendGrid API key for transactional email (password reset).
# Get one at https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=your_sendgrid_api_key_here

# Verified sender address in SendGrid (must be verified in your SendGrid account).
FROM_EMAIL=noreply@yourdomain.com

# Optional: User-Agent for Nominatim (OpenStreetMap) geocoding. Defaults to "ETradie/1.0 (local development)".
# If you run in production, set to something like "ETradie/1.0 (https://yourapp.com; contact@yourapp.com)"
# GEOCODE_USER_AGENT=

